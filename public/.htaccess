# Enable URL rewriting
RewriteEngine On

# Set the base
RewriteBase /

# Remove trailing slash and redirect to .html file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1.html [L]

# Handle dashboard routes - serve the appropriate HTML file
# For /dashboard/purchases/123 -> serve /dashboard/purchases/_.html
RewriteRule ^dashboard/purchases/[0-9]+$ /dashboard/purchases/_.html [L]
RewriteRule ^dashboard/sales/[0-9]+$ /dashboard/sales/_.html [L]
RewriteRule ^dashboard/orders/[0-9]+$ /dashboard/orders/_.html [L]
RewriteRule ^dashboard/deliveries/[0-9]+$ /dashboard/deliveries/_.html [L]
RewriteRule ^dashboard/adjustments/[0-9]+$ /dashboard/adjustments/_.html [L]

# Handle requests without extension - try to add .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# If still not found, serve index.html (for SPA fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
